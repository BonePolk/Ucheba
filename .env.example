# Copy to .env, choose a long password, generate a Fernet key (see README).
ADMIN_PASSWORD=
INTEGRATION_ENCRYPTION_KEY=
# Enable when accessing the site through HTTPS.
COOKIE_SECURE=false

# Необязательно: импорт старого ключа Lucheba в профиль admin при первом запуске.
# Новые ключи вводятся в профиле пользователя.
LUNA_API_KEY=

# Silo: придумайте отдельный логин и длинный пароль хранилища.
SILO_ACCESS_KEY=
SILO_SECRET_KEY=

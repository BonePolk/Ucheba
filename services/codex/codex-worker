#!/bin/sh
owner="$1"
shift
case "$owner" in ''|*[!0-9]*) exit 1 ;; esac
user_home="/home/codex/.codex/users/$owner"
user_uid=$((10000 + owner))
exec /usr/bin/setpriv --reuid="$user_uid" --regid="$user_uid" --clear-groups \
  /usr/bin/env -i HOME="$user_home" CODEX_HOME="$user_home/.codex" \
  PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 /usr/local/bin/codex-native "$@"
